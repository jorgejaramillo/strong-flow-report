.env
.mcp.json
.DS_Store
node_modules/

# Config real de cada cliente vive en Flow; el config.json local solo
# guarda el API key (ver CONFIG_SPEC.md). _template sigue trackeado como
# referencia de forma, no tiene secretos.
clients/*/config.json
!clients/_template/config.json
clients/*/.flow-cache.json

# Fuentes crudas de cada corrida (regenerables desde GSC/crawler) — se versiona report.html y data.json
reports/*/*/data/

# Repos separados con su propio remoto — no deben anidarse como carpetas
# normales de este repo (cada uno tiene su propio .git).
mcp-google-search-console/
dataforseo-mcp/

# Descargas sueltas de pruebas anteriores del crawler (clientes ajenos, tests) —
# el skill ahora guarda en reports/<slug>/<fecha>/data/crawl/, que ya está ignorado arriba.
crawler/output/
